# ─── Database (Turso / libSQL) ────────────────────────────────────────────────
# Sign up free at https://turso.tech, create a database, then paste the values.
# For LOCAL DEV leave both lines commented out — the app uses file:data.sqlite.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
# REQUIRED in production. Falls back to "dev_secret_change_me" only in dev.
JWT_SECRET=replace_with_a_long_random_secret

# ─── Vercel Blob (file uploads — avatars & member photos) ────────────────────
# Automatically injected by Vercel when you add Blob storage to your project.
# For local dev: run `vercel env pull .env.local` after linking your project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
